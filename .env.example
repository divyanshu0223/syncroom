# ==============================================================================
# SyncRoom - Production Environment Variables Template
# ==============================================================================
# NOTE: This file lists the variable NAMES only.
# Copy this file to .env and configure real values for your environment.
# Never commit real secrets, API keys, or database passwords to version control.
# ==============================================================================

# Server Runtime
NODE_ENV=
PORT=

# Allowed Client Origins for CORS (comma-separated if multiple)
# In production, set to your frontend HTTPS domain (e.g. https://syncroom.example.com)
CLIENT_ORIGIN=
ALLOWED_ORIGINS=

# Application Base URL (used for OAuth redirects and canonical links)
APP_URL=

# Rate Limiting Configuration (Optional - sensible defaults applied if blank)
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=
RATE_LIMIT_AUTH_MAX=
RATE_LIMIT_SPOTIFY_MAX=

# Persistent Session Configuration
SESSION_MAX_AGE_DAYS=

# Spotify OAuth Integration (Optional)
# Registered on Spotify Developer Dashboard (https://developer.spotify.com/dashboard)
# Secrets must remain STRICTLY server-side. Never expose to client bundles.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# PostgreSQL Database Configuration (Prisma ORM)
# DATABASE_URL: Pooled PostgreSQL connection string for application runtime (e.g. pgBouncer / Supabase / Neon / RDS)
DATABASE_URL=
# DIRECT_URL: Direct PostgreSQL connection string for Prisma migrations and schema operations
DIRECT_URL=

# YouTube Data API Integration (Optional)
# Registered on Google Cloud Console (YouTube Data API v3)
# Key must remain STRICTLY server-side. Never expose to client bundles.
YOUTUBE_API_KEY=

# Optional AI Features
GEMINI_API_KEY=

# ==============================================================================
# Public Frontend Variables (Vite client bundle)
# ==============================================================================
# Only variables prefixed with VITE_ are exposed to the client bundle.
# Never put secrets into VITE_ variables.
# In production, specify if frontend and backend are hosted on separate domains.
# If omitted or empty, client dynamically derives from window.location.
VITE_API_URL=
VITE_WS_URL=
